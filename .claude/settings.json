{
  "permissions": {
    "allow": [
      "Bash(python -m pytest)",
      "Bash(pytest)",
      "Bash(uvicorn core.app:app *)",
      "Bash(./start.sh)",
      "Bash(pip install *)",
      "Bash(pip show *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_COST_WARNINGS": "1"
  }
}
