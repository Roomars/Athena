# ─── API Keys — copiare in .env e non committare mai ─────────────────────────
# cp .env.template .env   (.env è in .gitignore — sicuro)
# ⚠ NON inserire chiavi reali in questo file — usa solo placeholder

# ─── GLM via NVIDIA NIM (GRATUITO — raccomandato per delega GLM) ─────────────
# Registrati su build.nvidia.com — no carta richiesta, verifica telefono
# Modello: z-ai/glm-5.1 | 203K context | 40 RPM | $0
# python3 execution/glm-call.py --provider nvidia --probe
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Z.ai international (Coding Plan — Claude Code usa GLM come backend) ─────
# https://z.ai — $10/mese, Claude Code gira interamente su GLM-5.1
# Attiva con: ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ZAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── OpenRouter (accesso unificato a 200+ modelli) ───────────────────────────
# https://openrouter.ai — pay-per-use, GLM-5.1 disponibile
# usa --provider openrouter nel glm-call.py
OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# Solo se usi Claude via API diretta (non Claude Code CLI)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Deploy ──────────────────────────────────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_SECRET=change-me-in-production
