{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athena",
  "version": "0.1.0",
  "identifier": "com.roby.athena",
  "build": {
    "devUrl": "http://localhost:8000",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "http://localhost:8000",
        "width": 680,
        "height": 600,
        "decorations": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utilities",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
